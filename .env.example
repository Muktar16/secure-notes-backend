# Copy to .env and fill in.

# Local MongoDB via docker-compose
MONGODB_URI=mongodb://admin:password@localhost:27017/secure-notes?authSource=admin
# ...or MongoDB Atlas (Network Access must allow your deploy platform)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secure-notes?retryWrites=true&w=majority

# Minimum 16 characters — the app refuses to start otherwise.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRY=24h

BACKEND_PORT=5001

# Comma-separated allow-list of browser origins.
FRONTEND_URL=http://localhost:3000
